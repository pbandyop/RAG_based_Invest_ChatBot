# Copy to `.env` in the repository root (same folder as README.md).
# `.env` is listed in `.gitignore` — do not commit real secrets.

# Groq — Phase 3 LLM answer generation (optional; extractive fallback if unset).
# Create a key at https://console.groq.com/
GROQ_API_KEY=

# Hugging Face — optional; better Hub rate limits when downloading embedding models (Phase 2).
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Phase 6 — optional API overrides (see config/phase6/defaults.json)
# PHASE6_INDEX_DIR=
# PHASE6_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
